package-as: Instance-Spell-Collector

enable-nolib-creation: no

manual-changelog:
  filename: .release-changelog.md
  markup-type: markdown

ignore:
  - .github
  - .agents-cache
  - .discord-release.md
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - .release-changelog-section.md
  - AGENTS.md
  - APIDocumentation
  - CHANGELOG.md
  - CODE_OF_CONDUCT.md
  - CONTRIBUTING.md
  - README.md

move-folders:
  Instance-Spell-Collector/!InstanceSpellCollector: !InstanceSpellCollector
